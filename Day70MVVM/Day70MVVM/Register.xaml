<Window x:Class="Day70MVVM.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Day70MVVM"
        xmlns:vm="clr-namespace:MVVM.ViewModel;assembly=MVVM.ViewModel"
        mc:Ignorable="d"
        Title="Register" Height="450" Width="800">
    <Window.Resources>
        <vm:RegisterViewModel x:Key="RegViewModel"></vm:RegisterViewModel>
    </Window.Resources>
    <Window.DataContext>
        <Binding Source="{ StaticResource RegViewModel }"></Binding>
    </Window.DataContext>
    <StackPanel DataContext="{Binding RegModel}"><!--//ViewModel la iruka propertya Model ku move panathala athoda propertya inga bind pananum-->
        <TextBlock Text="Name" ></TextBlock>      <!--Ethuku ipdi stackpanel la binding panrom na ,Normala UI la Bind panumpothu property name mention panuvom.But inga Property MVVM.Model class ku move aanathala athoda Property_um sethu bind pananum.-->  
        <TextBox x:Name="txtname" Text="{Binding Name}"></TextBox>
        <TextBlock Text="Age"></TextBlock>
        <TextBox Text="{Binding Age}"></TextBox>
        <TextBlock Text="Qualification"></TextBlock>
        <TextBox Text="{Binding Qualification}"></TextBox>
        <TextBlock Text="Salary"></TextBlock>
        <TextBox Text="{Binding Salary}"></TextBox>


        <Button Content="register"></Button>
    </StackPanel>
</Window>
